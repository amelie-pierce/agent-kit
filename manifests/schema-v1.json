{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amelie-pierce/agent-kit/blob/main/manifests/schema-v1.json",
  "title": "Agent Kit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "nodeMinimum", "tools", "neverShip"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "nodeMinimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "neverShip": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tool" } }
  },
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "profile", "classification", "version", "approvedUpstream", "license", "runtimeMinimum", "artifacts", "installLocation", "detection"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["core", "claude", "codex", "figma"] },
        "classification": { "enum": ["shareable", "per-user-login", "never-ship"] },
        "version": { "$ref": "#/$defs/version" },
        "approvedUpstream": { "type": "string", "pattern": "^https://" },
        "license": { "$ref": "#/$defs/license" },
        "runtimeMinimum": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifacts": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^(darwin|linux|wsl2|windows)-(arm64|x64)$" },
          "additionalProperties": { "$ref": "#/$defs/artifact" }
        },
        "installLocation": { "$ref": "#/$defs/location" },
        "detection": { "$ref": "#/$defs/detection" }
      }
    },
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "status", "reason"],
      "properties": {
        "kind": { "enum": ["release", "git-commit"] },
        "value": { "type": ["string", "null"] },
        "status": { "enum": ["verified", "unverified"] },
        "reason": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "properties": { "value": { "type": "string", "minLength": 1 } } }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "pattern": "^https://" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "sha256", "status", "reason"],
      "properties": {
        "url": { "type": ["string", "null"], "pattern": "^https://" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "status": { "enum": ["verified", "unverified"] },
        "reason": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "properties": { "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } } }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath"],
      "properties": { "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$" } }
    },
    "detection": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command", "args"],
      "properties": {
        "kind": { "enum": ["command", "git-head"] },
        "command": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "git-head" }, "command": { "const": "git" }, "args": { "const": ["rev-parse", "HEAD"] } } },
        { "properties": { "kind": { "const": "command" }, "args": { "enum": [["--version"], ["-version"]] } } }
      ]
    }
  }
}
